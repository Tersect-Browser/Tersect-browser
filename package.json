{
    "name": "tersect-browser",
    "version": "0.9.0",
    "description": "Tersect Browser application monorepo",
    "scripts": {
        "install-backend": "cd backend && npm install",
        "install-web": "cd web && npm install",
        "install": "npm-run-all install-backend install-web",
        "backend": "cd backend && npm start",
        "web": "cd web && npm run dev",
        "dev": "npm-run-all -p backend web",
        "typecheck": "npm-run-all \"typecheck:*\"",
        "typecheck:backend": "cd backend && npm run typecheck",
        "typecheck:web": "cd web && npm run typecheck",
        "lint": "npm-run-all \"lint:*\"",
        "lint:backend": "cd backend && npm run lint",
        "lint:web": "cd web && npm run lint",
        "build": "node scripts/build.js",
        "deploy": "node --trace-warnings ./dist/server.js --config tbconfig.json",
        "clean": "cd backend && npm run clean && cd .. && rimraf dist/ node_modules/"
    },
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://tomkurowski@bitbucket.org/tomkurowski/tersect-browser.git"
    },
    "author": {
        "name": "Tomasz Kurowski",
        "email": "t.j.kurowski@cranfield.ac.uk"
    },
    "license": "MIT",
    "homepage": "https://bitbucket.org/tomkurowski/tersect-browser#readme",
    "devDependencies": {
        "npm-run-all": "^4.1.5",
        "rimraf": "^3.0.0",
        "yargs": "^17.7.2"
    }
}
