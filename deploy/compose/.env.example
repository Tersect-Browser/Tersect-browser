# Settings of the production stack (docker-compose.yml). The Terraform modules
# generate this file; fill it in by hand for a manual deployment.
# Passwords: letters and digits only (they go into connection URLs).

# Images, as pushed by deploy/scripts/push-images.sh
TB_IMAGE_WEB=registry.example.org/tersect/web:1.0.0
TB_IMAGE_BACKEND=registry.example.org/tersect/backend:1.0.0
TB_IMAGE_PIPELINE=registry.example.org/tersect/pipeline:1.0.0

# Where the site is served. A domain gets an automatic HTTPS certificate
# (ports 80 and 443 must be reachable from the internet for that).
TB_SITE_ADDRESS=tersect.example.org
TB_PUBLIC_URL=https://tersect.example.org
# Empty for a domain; "tls internal" for a self-signed certificate on an IP.
TB_TLS_DIRECTIVE=
TB_HTTP_PORT=80
TB_HTTPS_PORT=443

# Persistent data (a dedicated disk)
TB_DATA_DIR=/data

# Databases
TB_DB_NAME=tersect_browser_gp
TB_MONGO_USER=tersect
TB_MONGO_PASSWORD=change-me
MONGO_ROOT_PASSWORD=change-me
CLICKHOUSE_ADMIN_PASSWORD=change-me
CLICKHOUSE_READER_PASSWORD=change-me

# Login for adding and managing datasets. For a site that anyone may browse:
# set a password here and leave site.d/auth.caddy out, so that only the
# dataset management asks for it. Empty: no login in the app (protect the
# whole site with site.d/auth.caddy instead). Avoid ' and $ in the password.
TB_ADMIN_USER=admin
TB_ADMIN_PASSWORD=

# Dataset assistant (optional; needs a GPU). COMPOSE_PROFILES=assistant starts
# the model container without passing --profile on the command line.
COMPOSE_PROFILES=
TB_ASSISTANT_URL=
TB_ASSISTANT_MODEL=qwen3:14b
TB_ASSISTANT_CONTEXT_CHARS=24000
OLLAMA_CONTEXT_LENGTH=16384
