# Settings of one HPC deployment, read by tersect-stack.sh and tersect.sbatch.
# The Terraform module (deploy/terraform/modules/hpc-slurm) writes this file;
# copy it to stack.env and fill it in for a deployment by hand. Shell syntax:
# NAME='value'. Passwords go in secrets.env, not here. Anything left out
# keeps the default shown.

TB_NAME='tersect'

# --- Images: registry/repository:tag (pulled as docker://), any URI Apptainer
# can pull, or the absolute path of a .sif file ---------------------------------
TB_IMAGE_WEB='registry.example.org/tersect/web:1.0.0'
TB_IMAGE_BACKEND='registry.example.org/tersect/backend:1.0.0'
TB_IMAGE_PIPELINE='registry.example.org/tersect/pipeline:1.0.0'
#TB_IMAGE_MONGO='mongo:8.0'
#TB_IMAGE_CLICKHOUSE='clickhouse/clickhouse-server:25.8'
#TB_IMAGE_OLLAMA='ollama/ollama:0.40.16'
# login: you run 'tersect-stack.sh pull' on the login node. job: the job pulls.
#TB_PULL_ON='login'

# --- Apptainer ------------------------------------------------------------------
#TB_APPTAINER='apptainer'                    # or singularity, or a path
#TB_MODULES=''                               # e.g. 'apptainer' for "module load apptainer"
#TB_APPTAINER_FLAGS='--containall --no-home'

# --- Paths (default: data/ in the deployment directory) --------------------------
#TB_DATA_DIR='/project/mygroup/tersect-data'
#TB_SHARED_DIR='/project/mygroup/vcf'        # files users may pick as inputs (read-only)
# Databases on the node's own disk, copied back at stop. Read README.md first.
#TB_NODE_LOCAL_DIR='$TMPDIR'

# --- Network: ports on the compute node, shared with every user of the node ------
#TB_BIND_ADDRESS='127.0.0.1'                 # of the site; everything else is always 127.0.0.1
#TB_HTTP_PORT='8080'
#TB_BACKEND_PORT='14300'
#TB_BUILDER_PORT='14310'
#TB_MONGO_PORT='27117'
#TB_CLICKHOUSE_HTTP_PORT='18123'
#TB_CLICKHOUSE_TCP_PORT='19000'
#TB_OLLAMA_PORT='21434'

# --- The tunnel, as 'status' prints it --------------------------------------------
TB_SSH_LOGIN='you@login.hpc.example.org'
#TB_SSH_PORT='22'
#TB_TUNNEL_LOCAL_PORT='8080'
#TB_PUBLIC_URL='http://localhost:8080'       # must match the tunnel's local port

# --- Application -------------------------------------------------------------------
#TB_BASIC_AUTH_USER='tersect'
#TB_DB_NAME='tersect_browser_gp'
#TB_MONGO_USER='tersect'
#TB_MONGO_CACHE_GB='1'
#TB_CLICKHOUSE_LOW_MEMORY='1'                # clickhouse/low-memory.xml
#TB_BUILD_CORES='8'                          # default: the job's --cpus-per-task

# --- The job -------------------------------------------------------------------------
TB_AUTO_RESUBMIT='1'                         # queue again at the time limit
#TB_STOP_GRACE='300'                         # keep equal to --signal=B:TERM@... in tersect.sbatch

# --- Dataset assistant (off unless one of these is set) -----------------------------
#TB_ASSISTANT_URL='https://llm.example.org/v1'   # an existing OpenAI-compatible server
#TB_RUN_OLLAMA='1'                               # or run Ollama in the job (needs a GPU)
#TB_ASSISTANT_MODEL='qwen3:14b'
#TB_ASSISTANT_CONTEXT_CHARS='24000'
#TB_OLLAMA_CONTEXT_LENGTH='16384'
