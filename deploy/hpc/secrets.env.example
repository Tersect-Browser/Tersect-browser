# Passwords of one HPC deployment. Copy to secrets.env, chmod 600, fill in.
# Letters and digits only for the first four (they go into connection URLs);
# for example: openssl rand -hex 16
TB_MONGO_PASSWORD='change-me'
MONGO_ROOT_PASSWORD='change-me'
CLICKHOUSE_ADMIN_PASSWORD='change-me'
CLICKHOUSE_READER_PASSWORD='change-me'

# The shared login of the site. Without it the site has no password at all.
TB_BASIC_AUTH_PASSWORD='change-me-to-something-long'

# Optional: login for the registry of the application images.
#APPTAINER_DOCKER_USERNAME='tersect-pull'
#APPTAINER_DOCKER_PASSWORD='a-read-only-token'

# Optional: bearer token for TB_ASSISTANT_URL.
#TB_ASSISTANT_API_KEY=''
