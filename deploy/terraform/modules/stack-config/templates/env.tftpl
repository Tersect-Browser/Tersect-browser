# Settings of the production stack (docker-compose.yml) for "${name}".
# Written by Terraform (deploy/terraform/modules/stack-config); changes made
# here by hand are overwritten at the next sync.

# Images
TB_IMAGE_WEB=${images.web}
TB_IMAGE_BACKEND=${images.backend}
TB_IMAGE_PIPELINE=${images.pipeline}

# Where the site is served
TB_SITE_ADDRESS=${site_address}
TB_PUBLIC_URL=${public_url}
TB_TLS_DIRECTIVE=${tls_directive}
TB_HTTP_PORT=80
TB_HTTPS_PORT=443

# Persistent data
TB_DATA_DIR=${data_dir}

# Databases
TB_DB_NAME=${database_name}
TB_MONGO_USER=${mongo_username}
TB_MONGO_PASSWORD=${mongo_password}
MONGO_ROOT_PASSWORD=${mongo_root_password}
CLICKHOUSE_ADMIN_PASSWORD=${clickhouse_admin_password}
CLICKHOUSE_READER_PASSWORD=${clickhouse_reader_password}

# Dataset assistant
%{ if enable_assistant ~}
COMPOSE_PROFILES=assistant
TB_ASSISTANT_URL=http://ollama:11434/v1
%{ else ~}
COMPOSE_PROFILES=
TB_ASSISTANT_URL=
%{ endif ~}
TB_ASSISTANT_MODEL=${assistant_model}
TB_ASSISTANT_CONTEXT_CHARS=${assistant_context_chars}
OLLAMA_CONTEXT_LENGTH=${ollama_context_length}
