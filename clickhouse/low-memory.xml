<!--
  ClickHouse on a small host (the development stack runs it in a Docker VM of
  a few GB). The server's defaults assume a large machine:

  - metric_log and the other telemetry tables are thousands of columns wide;
    merging 15 MB of metric_log took 4.4 GB of memory and made dataset loads
    fail with "memory limit exceeded" (code 241) on a 6 GiB Docker host.
  - the mark and uncompressed caches default to 5 GB and 8 GB.

  query_log is kept: it is narrow and useful for diagnosing slow searches.
-->
<clickhouse>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>

    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <index_mark_cache_size>134217728</index_mark_cache_size>

    <!-- Leave headroom for the other containers in the same VM. -->
    <max_server_memory_usage_to_ram_ratio>0.7</max_server_memory_usage_to_ram_ratio>

    <merge_tree>
        <!-- Merge very large parts less eagerly; wide variant rows need memory. -->
        <max_bytes_to_merge_at_max_space_in_pool>10737418240</max_bytes_to_merge_at_max_space_in_pool>
    </merge_tree>
</clickhouse>
