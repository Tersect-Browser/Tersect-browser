# Base image shared by the backend and the dataset seed job: the Tersect
# toolchain plus everything the analysis scripts call.
#
# linux/amd64 because rapidNJ is built with SSE2 intrinsics. On Apple Silicon
# this builds under emulation and the first build is slow (Julia packages).

FROM --platform=linux/amd64 node:26-bookworm

# 1) OS packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential wget curl cmake flex bison \
    python3 python3-venv bzip2 ca-certificates file jq \
    gfortran libopenblas-dev liblapack-dev \
    openjdk-17-jre-headless \
 && rm -rf /var/lib/apt/lists/*

# 2) Python venv for the dataset scripts and merge_phylip.py
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
COPY backend/src/scripts/requirements.venv.txt /tmp/requirements.venv.txt
RUN /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.venv.txt \
 && rm /tmp/requirements.venv.txt

# 3) rapidNJ (phenetic trees)
RUN git clone https://github.com/somme89/rapidNJ /tmp/rapidNJ \
 && cd /tmp/rapidNJ && make \
 && install -m755 ./bin/rapidnj /usr/local/bin/rapidnj \
 && rm -rf /tmp/rapidNJ

# 4) Tersect
RUN git clone https://github.com/tomkurowski/tersect.git /tmp/tersect \
 && mkdir /tmp/tersect/build \
 && cd /tmp/tersect/build \
 && cmake .. -DCMAKE_C_FLAGS="-fcommon" \
 && make -j"$(nproc)" \
 && make install \
 && rm -rf /tmp/tersect

# 5) Conda env "tersect" (environment.yml): bcftools, htslib, samtools,
#    ASTRAL (aster), and the Python/R stack used by the introgression scripts.
ARG MAMBA_VERSION=1.5.8
ENV MAMBA_ROOT_PREFIX=/opt/conda
RUN curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/${MAMBA_VERSION} \
  | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba
COPY environment.yml /tmp/environment.yml
RUN micromamba create -y -n tersect -f /tmp/environment.yml && micromamba clean -a -y

# Lookup order: venv first (its python3 has numpy for merge_phylip.py), then
# the conda env for bcftools, tabix, bgzip, samtools and astral.
ENV PATH="/opt/venv/bin:/opt/conda/envs/tersect/bin:${PATH}"

# 6) PhyloNet
ENV PHYLONET_HOME=/opt/phylonet
COPY ./PhyloNet.jar ${PHYLONET_HOME}/PhyloNet.jar
ENV PHYLONET_JAR=${PHYLONET_HOME}/PhyloNet.jar
RUN printf '%s\n' '#!/usr/bin/env bash' \
    'exec java ${PHYLONET_JAVA_OPTS} -jar "${PHYLONET_JAR}" "$@"' \
    > /usr/local/bin/phylonet && chmod +x /usr/local/bin/phylonet

# 7) Julia, for drawing PhyloNet networks (plot_phylonet.jl)
ARG JULIA_VERSION=1.10.5
ENV JULIA_DEPOT_PATH=/opt/julia_depot
RUN set -eux; \
    curl -fsSL "https://julialang-s3.julialang.org/bin/linux/x64/${JULIA_VERSION%.*}/julia-${JULIA_VERSION}-linux-x86_64.tar.gz" \
      | tar -xz -C /opt; \
    ln -s /opt/julia-${JULIA_VERSION} /opt/julia

# PhyloPlots draws through R (RCall), using R from the conda env. R's
# libraries need a newer libstdc++ than the one Julia bundles, so the julia
# command preloads the conda env's and points RCall at R.
RUN printf '%s\n' '#!/bin/sh' \
    'CONDA_ENV=/opt/conda/envs/tersect' \
    'export R_HOME="$CONDA_ENV/lib/R"' \
    'export LD_LIBRARY_PATH="$R_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' \
    'export LD_PRELOAD="$CONDA_ENV/lib/libstdc++.so.6${LD_PRELOAD:+:$LD_PRELOAD}"' \
    'exec /opt/julia/bin/julia "$@"' \
    > /usr/local/bin/julia && chmod +x /usr/local/bin/julia
RUN julia -e 'import Pkg; \
      Pkg.add(["PhyloNetworks", "PhyloPlots", "Compose", "Cairo", "ArgParse", "RCall"]); \
      Pkg.build("RCall"); Pkg.precompile(); \
      using RCall; println("RCall OK, R ", rcopy(R"R.version.string"))' \
 && chmod -R a+rwX "$JULIA_DEPOT_PATH"

WORKDIR /app
