{
    "name": "tersect-browser-backend",
    "version": "0.9.0",
    "license": "MIT",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "start": "tsx watch server-dev.ts --config ../tbconfig.json",
        "lint": "tslint --project .",
        "typecheck": "tsc --project . --noEmit",
        "build": "tsc --project . && ncp src/scripts ../dist/src/scripts && ncp node_modules ../dist/node_modules",
        "clean": "rimraf dist/ node_modules/"
    },
    "private": true,
    "dependencies": {
        "@clickhouse/client": "^1.25.0",
        "cors": "^2.8.6",
        "express": "^4.22.3",
        "hashids": "^2.3.0",
        "mongoose": "^9.12.1",
        "p-limit": "^3.1.0",
        "rxjs": "^7.8.2",
        "tmp": "^0.2.7",
        "yargs": "^17.7.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/node": "^26.6.6",
        "@types/tmp": "^0.2.6",
        "@types/yargs": "^17.0.35",
        "ncp": "^2.0.0",
        "rimraf": "^6.1.4",
        "tslint": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    }
}
